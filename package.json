{
  "name": "tiktok-live-studio",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok Live Studio 2D - dashboard streaming ala OBS (web)",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev:backend": "node --watch backend/server.js",
